<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:descendantFocusability="blocksDescendants"
    android:orientation="vertical"
    android:padding="3dp">

    <!-- 타이틀: 카드 영역 바깥 (13→14sp로 소폭 확대) -->
    <TextView
        android:id="@+id/widget_tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textColor="#0D1B3E"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- 요약 카드 영역 (파란 배경 / 카드 높이 줄이기: weight=1→wrap_content + 패딩 축소) -->
    <LinearLayout
        android:id="@+id/widget_card_body"
        android:minHeight="120dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:background="@drawable/widget_card_bg"
        android:padding="21dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_tv_summary_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#4A5568"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_tv_summary_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#4A5568"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_tv_summary_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#4A5568"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>
