<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="12dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:src="@drawable/img_widget_toplogo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/iv_widget_bookmark"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/img_widget_bookmark_inactive" />
    </LinearLayout>

    <AdapterViewFlipper
        android:id="@+id/widget_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:autoStart="false"
        android:flipInterval="0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_dot_0"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="3dp"
            android:src="@drawable/widget_dot_active" />

        <ImageView
            android:id="@+id/widget_dot_1"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="3dp"
            android:src="@drawable/widget_dot_inactive" />

        <ImageView
            android:id="@+id/widget_dot_2"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="3dp"
            android:src="@drawable/widget_dot_inactive" />

        <ImageView
            android:id="@+id/widget_dot_3"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="3dp"
            android:src="@drawable/widget_dot_inactive" />

        <ImageView
            android:id="@+id/widget_dot_4"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="3dp"
            android:src="@drawable/widget_dot_inactive" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_prev"
            android:layout_width="56dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_nav_button_bg"
            android:gravity="center"
            android:text="이전"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/widget_btn_next"
            android:layout_width="56dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_nav_button_bg"
            android:gravity="center"
            android:text="다음"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
