<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/widget_background"
    android:paddingStart="15dp"
    android:paddingTop="15dp"
    android:paddingEnd="15dp"
    android:paddingBottom="10dp">

    <!-- 헤더 영역: 왼쪽 로고, 오른쪽 북마크 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="5dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:src="@drawable/img_widget_toplogo3" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/iv_widget_bookmark"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/img_widget_bookmark_inactive" />
    </LinearLayout>


    <!-- 본문 영역: 제목 + 세 줄 요약 카드가 들어가는 카드 플리퍼 -->
    <AdapterViewFlipper
        android:id="@+id/widget_flipper"
        android:layout_width="match_parent"
        android:layout_height="189dp"
        android:layout_marginTop="8dp"
        android:autoStart="false"
        android:flipInterval="0" />

    <!-- 페이지 인디케이터: 현재 노출 중인 카드 위치 표시 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_dot_0"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="3dp"
            android:src="@drawable/widget_dot_active" />

        <ImageView
            android:id="@+id/widget_dot_1"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="3dp"
            android:src="@drawable/widget_dot_inactive" />

        <ImageView
            android:id="@+id/widget_dot_2"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_marginHorizontal="3dp"
            android:src="@drawable/widget_dot_inactive" />

        <ImageView
            android:id="@+id/widget_dot_3"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="3dp"
            android:src="@drawable/widget_dot_inactive" />

        <ImageView
            android:id="@+id/widget_dot_4"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="3dp"
            android:src="@drawable/widget_dot_inactive" />
    </LinearLayout>

    <!-- 하단 이동 버튼 영역: 이전/다음 카드 이동 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- 이전 카드로 이동 -->
        <TextView
            android:id="@+id/widget_btn_prev"
            android:layout_width="160dp"
            android:layout_height="50dp"
            android:background="@drawable/widget_nav_button_bg"
            android:gravity="center"
            android:text="이전"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <!-- 다음 카드로 이동 -->
        <TextView
            android:id="@+id/widget_btn_next"
            android:layout_width="160dp"
            android:layout_height="50dp"
            android:background="@drawable/widget_nav_button_next_bg"
            android:gravity="center"
            android:text="다음"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
